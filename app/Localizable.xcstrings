    "Applies to the next take or rewrite. Your own edits are never limited. Each track can override these in its sheet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt für den nächsten Take oder das nächste Neuschreiben. Deine eigenen Änderungen werden nie eingeschränkt. Jede Spur kann diese Werte in ihrem Blatt überschreiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica a la próxima toma o reescritura. Tus propias ediciones nunca se limitan. Cada pista puede cambiarlos en su hoja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'applique à la prochaine prise ou réécriture. Vos propres modifications ne sont jamais limitées. Chaque piste peut les remplacer dans sa fiche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale per il prossimo take o la prossima riscrittura. Le tue modifiche non sono mai limitate. Ogni traccia può sostituirli nella sua scheda."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale para o próximo take ou reescrita. Suas próprias edições nunca são limitadas. Cada faixa pode substituir esses valores na própria ficha."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "适用于下一个版本或重写。你自己的编辑不会受到限制。每条音轨可在自己的面板中单独设置。"
          }
        }
      }
    },
