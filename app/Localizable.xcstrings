      "comment" : "A percentage value describing the current volume of a sound effect.",
      "isCommentAutoGenerated" : true
    },
    "%lld percent, %@ to %@" : {
      "comment" : "The accessibility value of the slider is a percentage of the value, followed by a description of the range. The first argument is the percentage, the second argument is the low value, and the third argument is the high value. The second argument is the string “Loose” or the string “Flat”. The third argument is the string “Tight” or the string “Expressive”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
