          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duración predeterminada de las notas nuevas; se puede cambiar por pista en sus efectos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durée par défaut des nouvelles notes ; modifiable par piste dans ses effets."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
