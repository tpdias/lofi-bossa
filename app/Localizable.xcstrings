    "The preview plays the song at its mixer levels next to the video's own sound." : {
      "comment" : "A description of the preview of the video soundtrack.",
      "isCommentAutoGenerated" : true
    },
    "The ring-out after the last note is folded onto the start, so the file repeats with no gap or click. Fades are off." : {
      "comment" : "A description of the seamless loop option.",
      "isCommentAutoGenerated" : true
    },
    "The same seed, style, length and model write the same song. Typing a number keeps it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gleicher Seed, Stil, gleiche Länge und gleiches Modell ergeben denselben Song. Wenn du eine Zahl eingibst, bleibt sie erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La misma semilla, estilo, duración y modelo escriben la misma canción. Si escribes un número, se mantiene."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La même graine, le même style, la même durée et le même modèle écrivent le même morceau. Saisir un nombre la conserve."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stesso seed, stile, durata e modello scrivono lo stesso brano. Digitando un numero lo mantieni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mesma semente, estilo, duração e modelo escrevem a mesma música. Digitar um número a mantém."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相同的种子、风格、时长和模型会生成相同的曲子。输入一个数字即可固定它。"
          }
        }
      }
    },
    "The song couldn't be extended." : {
