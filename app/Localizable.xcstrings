    },
    "Drag anywhere on a card. %@ defaults, adjusted. Reset returns to them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe irgendwo auf eine Karte. Standardwerte für %@, angepasst. „Zurücksetzen“ stellt sie wieder her."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra en cualquier punto de una tarjeta. Ajustes de %@, modificados. Restablecer vuelve a ellos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser n'importe où sur une carte. Réglages par défaut de %@, modifiés. Réinitialiser les rétablit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina in un punto qualsiasi di una scheda. Impostazioni predefinite di %@, modificate. Ripristina le reimposta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste em qualquer lugar de um cartão. Padrões de %@, ajustados. Redefinir volta a eles."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在任意卡片上拖动即可调整。%@默认设置,已调整。“还原”可恢复默认。"
          }
        }
      }
    },
