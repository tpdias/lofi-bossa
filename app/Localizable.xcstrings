          }
        }
      }
    },
    "How long this track's new notes are, on the next rewrite or take." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie lang die neuen Noten dieser Spur beim nächsten Neuschreiben oder Take sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duración de las notas nuevas de esta pista en la próxima reescritura o toma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durée des nouvelles notes de cette piste à la prochaine réécriture ou prise."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durata delle nuove note di questa traccia alla prossima riscrittura o al prossimo take."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
