  },
  "font": {
    "largeTitle": {
      "size": 26,
      "weight": "bold",
      "design": "rounded"
    },
    "title": {
      "size": 17,
      "weight": "semibold",
      "design": "rounded"
    },
    "headline": {
      "size": 14,
      "weight": "semibold",
      "design": "rounded"
    },
    "body": {
      "size": 13,
      "weight": "regular",
      "design": "default"
    },
    "bodyMedium": {
      "size": 13,
      "weight": "medium",
      "design": "default"
    },
    "caption": {
      "size": 11,
      "weight": "medium",
      "design": "default"
    },
    "timecode": {
      "size": 20,
      "weight": "semibold",
      "design": "rounded",
      "monospacedDigits": true
    }
  },
  "motion": {
    "sweepSeconds": 1.8,
    "writeHeadPulseSeconds": 1.2,
    "spinnerSeconds": 0.8,
