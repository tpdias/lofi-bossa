  "elevation": {
    "$description": "Two stacked shadows per level: tight and dark, then wide and warm. Pressed = 0.5x/0.4x radius/offset. Increase Contrast swaps shadows for a 1.5 pt border. Mirrors LFBElevation in Tokens.swift.",
    "low":  { "tight": { "radius": 1,   "y": 1,   "opacity": 0.14 }, "wide": { "radius": 4,  "y": 2,  "opacity": 0.08 } },
    "mid":  { "tight": { "radius": 1.5, "y": 1.5, "opacity": 0.18 }, "wide": { "radius": 10, "y": 5,  "opacity": 0.14 } },
    "high": { "tight": { "radius": 2,   "y": 2,   "opacity": 0.22 }, "wide": { "radius": 20, "y": 10, "opacity": 0.20 } },
    "highlight": "1 pt inner top stroke, white 25% fading out by the middle; 12% when pressed",
    "pressedScale": 0.97
  },
  "glow": {
    "$description": "Note glow and sparks (Effects/NoteGlow.swift, NoteParticles.swift). Setting: Note effects Full / Subtle / Off, default Full; Reduce Motion behaves as Subtle.",
    "haloRadius": 8,
    "haloPadding": 3.5,
    "releaseSeconds": 0.18,
    "particleLifeSeconds": 0.6,
    "maxParticles": 300
  },
  "themes": {
    "$description": "Per-style theme: tints the primary button, Generate glow, note glow. Mirrors LFBTheme in Tokens.swift.",
    "lofi":  { "accent": { "light": "#6B46B8", "dark": "#B9A1F2" }, "onAccent": { "light": "#FFFFFF", "dark": "#1E1233" }, "glow": { "light": "#E08A12", "dark": "#FFB547" } },
    "bossa": { "accent": { "light": "#0B7A78", "dark": "#5CCBC4" }, "onAccent": { "light": "#FFFFFF", "dark": "#06201F" }, "glow": { "light": "#C9A15A", "dark": "#EBD6A4" } }
  },
  "brand": {
    "displayName": "Saudade — Lo-Fi & Bossa",
    "wordmark": "Saudade (system serif, semibold italic)"
  }
}
