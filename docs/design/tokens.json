  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24
  },
  "radius": {
    "key": 5,
    "button": 7,
    "segmented": 8,
    "banner": 10,
    "card": 12,
    "sheet": 12,
    "capsule": "height / 2"
  },
  "size": {
    "trackHeaderWidth": 232,
    "trackRowMinHeight": 92,
    "trackRowCompactHeight": 44,
    "rulerHeight": 24,
    "transportHeight": 56,
    "toolbarHeight": 52,
    "recipeBarHeight": 49,
    "inspectorWidth": 272,
    "sidebarWidth": 216,
    "controlHeight": 28,
    "controlHeightSmall": 24,
    "playButton": 36,
    "effectCardHeight": 64,
    "libraryCardThumbHeight": 112,
    "minWindow": [
      900,
      560
